module

public import HyperellipticCurves.RedJ.Tower

/-!
# Stability of a splitting field under a compatible automorphism

The main theorems do not depend on this file: the pairing `λ` is defined on the kernel `J¹` of
reduction directly, so they need neither the finite-index theorem `thm:J1-index` nor its
Frobenius-equivariance machinery; the sole consumer of this file is
`HyperellipticCurves.Archive.J1FiniteIndex`.

For a polynomial `u` over a field `K`, the intermediate field
`L := IntermediateField.adjoin K (u.rootSet (AlgebraicClosure K))` generated by the roots of `u`
is finite-dimensional over `K` and splits `u` (`HyperellipticCurves.RedJ.Tower`).

If `u` is fixed by an automorphism `φK` of `K` and `Φ` is an automorphism of the algebraic closure
compatible with `φK` (i.e. `Φ ∘ algebraMap = algebraMap ∘ φK`), then `Φ` permutes the roots of `u`
(`ChabautyColeman.mem_rootSet_ringEquiv`), so `L` is stable under `Φ`
(`ChabautyColeman.adjoin_rootSet_stable`). The restriction of `Φ` to `L` is the automorphism
`ChabautyColeman.adjoinRootSetEquiv : L ≃+* L`, whose defining properties are
`ChabautyColeman.adjoinRootSetEquiv_coe` (it agrees with `Φ` under the coercion to the algebraic
closure) and `ChabautyColeman.adjoinRootSetEquiv_algebraMap` (it acts as `φK` on scalars).

This feeds the Frobenius-equivariance of the reduction map `ChabautyColeman.redJ` (blueprint
`thm:J1-index`).

NOTE (coercion discipline): whenever a ring equiv is used as a ring homomorphism (inside
`Polynomial.map` or `eval₂`), it is spelled with the ascription `(σ : A →+* B)`; mixing this with
the elaborator-inserted coercion in `p.map σ` produces syntactically different coercion terms whose
unification does not terminate in reasonable time.
-/

@[expose] public section

open Polynomial IntermediateField

namespace ChabautyColeman

section

variable {K : Type*} [Field K]

variable (φK : K ≃+* K) (Φ : AlgebraicClosure K ≃+* AlgebraicClosure K)
  (hΦ : ∀ x : K, Φ (algebraMap K (AlgebraicClosure K) x)
    = algebraMap K (AlgebraicClosure K) (φK x))
  {u : K[X]} (huφ : u.map (φK : K →+* K) = u)

include hΦ huφ in
/-- A `φK`-compatible automorphism `Φ` of the algebraic closure permutes the roots of a
`φK`-fixed polynomial `u`. -/
theorem mem_rootSet_ringEquiv {r : AlgebraicClosure K}
    (hr : r ∈ u.rootSet (AlgebraicClosure K)) :
    Φ r ∈ u.rootSet (AlgebraicClosure K) := by
  rw [Polynomial.mem_rootSet'] at hr ⊢
  refine ⟨hr.1, ?_⟩
  have hcomp : (Φ : AlgebraicClosure K →+* AlgebraicClosure K).comp (algebraMap K _)
      = (algebraMap K _).comp (φK : K →+* K) := RingHom.ext hΦ
  have h0 : (Φ : AlgebraicClosure K →+* AlgebraicClosure K) (aeval r u) = 0 := by
    rw [hr.2, map_zero]
  rw [aeval_def, Polynomial.hom_eval₂, hcomp, ← Polynomial.eval₂_map, huφ, ← aeval_def] at h0
  exact h0

include hΦ huφ in
/-- The field generated by the roots of a `φK`-fixed polynomial is stable under a
`φK`-compatible automorphism of the algebraic closure. -/
theorem adjoin_rootSet_stable {z : AlgebraicClosure K}
    (hz : z ∈ IntermediateField.adjoin K (u.rootSet (AlgebraicClosure K))) :
    Φ z ∈ IntermediateField.adjoin K (u.rootSet (AlgebraicClosure K)) := by
  set L : IntermediateField K (AlgebraicClosure K) :=
    IntermediateField.adjoin K (u.rootSet (AlgebraicClosure K)) with hLdef
  let T : IntermediateField K (AlgebraicClosure K) :=
    Subfield.toIntermediateField
      (L.toSubfield.comap (Φ : AlgebraicClosure K →+* AlgebraicClosure K)) fun x ↦ by
        rw [Subfield.mem_comap, IntermediateField.mem_toSubfield]
        change Φ (algebraMap K _ x) ∈ L
        rw [hΦ]
        exact IntermediateField.algebraMap_mem L (φK x)
  have hLT : L ≤ T := by
    rw [hLdef, IntermediateField.adjoin_le_iff]
    intro r hr
    change Φ r ∈ L
    exact IntermediateField.subset_adjoin K _ (mem_rootSet_ringEquiv φK Φ hΦ huφ hr)
  exact hLT hz

include hΦ in
/-- The inverse `Φ.symm` is compatible with `φK.symm` when `Φ` is compatible with `φK`. -/
theorem hΦ_symm (x : K) :
    Φ.symm (algebraMap K (AlgebraicClosure K) x)
      = algebraMap K (AlgebraicClosure K) (φK.symm x) := by
  have h := hΦ (φK.symm x)
  rw [φK.apply_symm_apply] at h
  rw [← h, Φ.symm_apply_apply]

include huφ in
/-- A `φK`-fixed polynomial is also `φK.symm`-fixed. -/
theorem huφ_symm : u.map (φK.symm : K →+* K) = u := by
  have h := congrArg (Polynomial.map (φK.symm : K →+* K)) huφ
  rw [Polynomial.map_map, RingEquiv.symm_comp, Polynomial.map_id] at h
  exact h.symm

include hΦ huφ in
/-- The restriction to `L = adjoin K (u.rootSet (AlgebraicClosure K))` of a `φK`-compatible
automorphism `Φ` of the algebraic closure, as a ring automorphism of `L`. -/
noncomputable def adjoinRootSetEquiv :
    IntermediateField.adjoin K (u.rootSet (AlgebraicClosure K))
      ≃+* IntermediateField.adjoin K (u.rootSet (AlgebraicClosure K)) where
  toFun z := ⟨Φ z, adjoin_rootSet_stable φK Φ hΦ huφ z.2⟩
  invFun z := ⟨Φ.symm z,
    adjoin_rootSet_stable φK.symm Φ.symm (hΦ_symm φK Φ hΦ) (huφ_symm φK huφ) z.2⟩
  left_inv z := Subtype.ext (Φ.symm_apply_apply z)
  right_inv z := Subtype.ext (Φ.apply_symm_apply z)
  map_mul' a b := Subtype.ext (by push_cast; rw [map_mul])
  map_add' a b := Subtype.ext (by push_cast; rw [map_add])

@[simp]
theorem adjoinRootSetEquiv_coe
    (z : IntermediateField.adjoin K (u.rootSet (AlgebraicClosure K))) :
    (adjoinRootSetEquiv φK Φ hΦ huφ z : AlgebraicClosure K) = Φ z := rfl

theorem adjoinRootSetEquiv_algebraMap (x : K) :
    adjoinRootSetEquiv φK Φ hΦ huφ (algebraMap K _ x) = algebraMap K _ (φK x) :=
  Subtype.ext (by rw [adjoinRootSetEquiv_coe]; exact hΦ x)

end

end ChabautyColeman

end
