module

public import HyperellipticCurves.Mathlib.RingTheory.DedekindDomain.SelmerGroup
public import Mathlib.NumberTheory.Padics.HeightOneSpectrum

import Mathlib.RingTheory.UniqueFactorizationDomain.ClassGroup

/-!
# The Selmer groups of `ℚ`

The primes of `ℤ` are those of `Rat.HeightOneSpectrum.primesEquiv`, with the natural generators
`Rat.HeightOneSpectrum.natGenerator`. For a finite set `S` of them, the Selmer group `ℚ(S, n)`
is generated by the classes of `-1` and of the generators of the primes in `S`.

## Main statements

* `Rat.HeightOneSpectrum.eq_primesEquiv_symm_of_natCast_mem`: the prime of `ℤ` containing a
  prime number `p` is `(p)`.
* `Rat.HeightOneSpectrum.under_eq_primesEquiv_symm_iff`: a prime of an integral extension of `ℤ`
  lies over `p` iff it contains `p`.
* `Rat.selmerGroup_eq_closure`: `ℚ(S, n)` is generated by `-1` and the primes in `S`.

Auxiliary material for the formalization of `2`-descent on hyperelliptic Jacobians;
upstreaming candidates for Mathlib.
-/

@[expose] public section

namespace Rat.HeightOneSpectrum

open IsDedekindDomain

section primesEquiv

variable {R : Type*} [CommRing R] [Algebra R ℚ] [IsIntegralClosure R ℤ ℚ] [IsDedekindDomain R]

@[simp]
theorem natGenerator_primesEquiv_symm (p : Nat.Primes) :
    natGenerator (primesEquiv.symm p : HeightOneSpectrum R) = p :=
  congr($(primesEquiv.apply_symm_apply p).val)

/-- `Rat.HeightOneSpectrum.natGenerator_primesEquiv_symm` for a prime given as `⟨p, hp⟩`, which
elaborates to a term of the subtype `{p // p.Prime}` and not of `Nat.Primes`, so that the general
lemma does not match it. -/
@[simp]
theorem natGenerator_primesEquiv_symm_mk {p : ℕ} (hp : p.Prime) :
    natGenerator (primesEquiv.symm ⟨p, hp⟩ : HeightOneSpectrum R) = p :=
  natGenerator_primesEquiv_symm ⟨p, hp⟩

end primesEquiv

/-- A prime of `ℤ` is generated by its `Rat.HeightOneSpectrum.natGenerator`. -/
theorem span_natGenerator_int (v : HeightOneSpectrum ℤ) :
    Ideal.span {(natGenerator v : ℤ)} = v.asIdeal := by
  ext
  simp [span_natGenerator, Ideal.mem_map_of_equiv]

/-- The prime of `ℤ` containing a prime number `p` is `(p)`. -/
theorem eq_primesEquiv_symm_of_natCast_mem {v : HeightOneSpectrum ℤ} {p : ℕ} (hp : p.Prime)
    (h : (p : ℤ) ∈ v.asIdeal) : v = primesEquiv.symm ⟨p, hp⟩ :=
  primesEquiv.eq_symm_apply.mpr <| Subtype.ext <| (Nat.prime_dvd_prime_iff_eq
    (prime_natGenerator v) hp).mp <| Int.natCast_dvd_natCast.mp <|
      Ideal.mem_span_singleton.mp ((span_natGenerator_int v).symm ▸ h)

/-- A prime `w` of a ring `B` integral over `ℤ` lies over the prime number `p` iff `p ∈ w`. -/
theorem under_eq_primesEquiv_symm_iff {B : Type*} [CommRing B] [IsDomain B] [Algebra ℤ B]
    [Algebra.IsIntegral ℤ B] {w : HeightOneSpectrum B} {p : ℕ} (hp : p.Prime) :
    w.under ℤ = primesEquiv.symm ⟨p, hp⟩ ↔ (p : B) ∈ w.asIdeal := by
  refine ⟨fun h ↦ ?_, fun h ↦ eq_primesEquiv_symm_of_natCast_mem hp
    (Ideal.mem_comap.mpr (by rwa [map_natCast]))⟩
  have hmem : (p : ℤ) ∈ (w.under ℤ).asIdeal := by
    rw [h, ← span_natGenerator_int, natGenerator_primesEquiv_symm_mk]
    exact Ideal.mem_span_singleton_self _
  simpa using Ideal.mem_comap.mp hmem

end Rat.HeightOneSpectrum

namespace Rat

open IsDedekindDomain HeightOneSpectrum Rat.HeightOneSpectrum

/-- **The Selmer group `ℚ(S, n)`**: for a finite set `S` of primes of `ℤ` and `n ≠ 0`, `ℚ(S, n)`
is generated by the classes of `-1` and of the prime numbers generating the primes in `S`. By
`IsDedekindDomain.selmerGroup_image_eq_range_sup_closure`, since `ℤ` has trivial class group and
units `±1`. -/
theorem selmerGroup_eq_closure {S : Set (HeightOneSpectrum ℤ)} (hS : S.Finite) {n : ℕ}
    [NeZero n] :
    selmerGroup (R := ℤ) (K := ℚ) (S := S) (n := n) =
      Subgroup.closure (insert ((-1 : ℚˣ) : Units.ModPow ℚ n) ((fun v ↦
        ((Units.mk0 (natGenerator v : ℚ) (Nat.cast_ne_zero.mpr (prime_natGenerator v).ne_zero) :
          ℚˣ) : Units.ModPow ℚ n)) '' S)) := by
  have h := selmerGroup_image_eq_range_sup_closure (K := ℚ) (n := n) hS (v := id)
    (fun v _ ↦ span_natGenerator_int v) (u := fun v ↦ Units.mk0 (natGenerator v : ℚ)
      (Nat.cast_ne_zero.mpr (prime_natGenerator v).ne_zero)) fun v _ ↦ by simp
  rw [Set.image_id] at h
  rw [h, Set.insert_eq, Subgroup.closure_union, ← Subgroup.zpowers_eq_closure]
  congr 1
  refine le_antisymm ?_ (Subgroup.zpowers_le.mpr ⟨(-1 : ℤˣ), by simp⟩)
  rintro _ ⟨y, rfl⟩
  induction y using QuotientGroup.induction_on with | H a => ?_
  rcases Int.units_eq_one_or a with rfl | rfl <;> simp [Subgroup.mem_zpowers]

end Rat

end
