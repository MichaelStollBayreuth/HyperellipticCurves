module

public import Mathlib.Algebra.Group.Subgroup.Finite

import HyperellipticCurves.Mathlib.Algebra.BigOperators.Group.Finset.Basic

/-!
# Subgroups generated by elements of order dividing `2`

## Main statements

* `Subgroup.mem_closure_range_iff_of_sq_eq_one`: in a commutative group, the subgroup generated by
  elements whose squares are `1` consists of their products over the finite sets of indices.
* `Subgroup.card_closure_range_eq_two_pow`: if moreover only the empty product is `1`, the
  subgroup has `2 ^ #ι` elements.
* `Subgroup.card_closure_range_eq_two_pow_of_monoidHom`: elements `g i` whose squares are `1`
  generate a subgroup with `2 ^ #ι` elements if the images under a homomorphism have only the
  empty product equal to `1`.
* `Subgroup.card_closure_range_le_two_pow`: in general it has at most `2 ^ #ι` elements.

Auxiliary material for the formalization of `2`-descent on hyperelliptic Jacobians; an
upstreaming candidate for Mathlib.
-/

@[expose] public section

open scoped symmDiff

namespace Subgroup

variable {G ι : Type*} [CommGroup G] {g : ι → G}

/-- In a commutative group, the subgroup generated by elements whose squares are `1` consists of
the products of these elements over the finite sets of indices. -/
theorem mem_closure_range_iff_of_sq_eq_one (hg : ∀ i, g i ^ 2 = 1) {x : G} :
    x ∈ closure (Set.range g) ↔ ∃ s : Finset ι, ∏ i ∈ s, g i = x := by
  classical
  refine ⟨fun hx ↦ ?_, fun ⟨s, hs⟩ ↦ hs ▸ prod_mem fun i _ ↦ subset_closure ⟨i, rfl⟩⟩
  induction hx using closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact ⟨{i}, Finset.prod_singleton g i⟩
  | one => exact ⟨∅, Finset.prod_empty⟩
  | mul x y _ _ hx hy =>
    obtain ⟨s, rfl⟩ := hx
    obtain ⟨t, rfl⟩ := hy
    exact ⟨s ∆ t, Finset.prod_symmDiff_of_sq_eq_one fun i _ ↦ hg i⟩
  | inv x _ hx =>
    obtain ⟨s, rfl⟩ := hx
    refine ⟨s, (inv_eq_of_mul_eq_one_right ?_).symm⟩
    rw [← sq, ← Finset.prod_pow, Finset.prod_eq_one fun i _ ↦ hg i]

/-- In a commutative group, elements `g i` whose squares are `1` and whose products over the
nonempty finite sets of indices are all different from `1` generate a subgroup of order
`2 ^ #ι`: the products over the finite sets of indices are its elements
(`Subgroup.mem_closure_range_iff_of_sq_eq_one`) and are pairwise distinct
(`Finset.prod_injective_of_sq_eq_one`). -/
theorem card_closure_range_eq_two_pow [Fintype ι] (hg : ∀ i, g i ^ 2 = 1)
    (h : ∀ s : Finset ι, ∏ i ∈ s, g i = 1 → s = ∅) :
    Nat.card (closure (Set.range g)) = 2 ^ Fintype.card ι := by
  rw [← Fintype.card_finset, ← Nat.card_eq_fintype_card]
  refine Nat.card_congr (Equiv.ofBijective (fun s ↦ ⟨∏ i ∈ s, g i,
    prod_mem fun i _ ↦ subset_closure ⟨i, rfl⟩⟩) ⟨fun _ _ hst ↦ ?_, fun x ↦ ?_⟩).symm
  · exact Finset.prod_injective_of_sq_eq_one hg h congr(Subtype.val $hst)
  · obtain ⟨s, hs⟩ := (mem_closure_range_iff_of_sq_eq_one hg).mp x.2
    exact ⟨s, Subtype.ext hs⟩

/-- In a commutative group, `n` elements whose squares are `1` generate a subgroup of order at
most `2 ^ n`: its elements are the products over the finite sets of indices
(`Subgroup.mem_closure_range_iff_of_sq_eq_one`). -/
theorem card_closure_range_le_two_pow [Fintype ι] (hg : ∀ i, g i ^ 2 = 1) :
    Nat.card (closure (Set.range g)) ≤ 2 ^ Fintype.card ι := by
  rw [← Fintype.card_finset, ← Nat.card_eq_fintype_card]
  refine Nat.card_le_card_of_surjective (fun s ↦ ⟨∏ i ∈ s, g i,
    prod_mem fun i _ ↦ subset_closure ⟨i, rfl⟩⟩) fun x ↦ ?_
  obtain ⟨s, hs⟩ := (mem_closure_range_iff_of_sq_eq_one hg).mp x.2
  exact ⟨s, Subtype.ext hs⟩

/-- In a commutative group, elements `g i` whose squares are `1` generate a subgroup of order
`2 ^ #ι` if their images under a homomorphism `Ψ` have only the empty product equal to `1` (a
form of `Subgroup.card_closure_range_eq_two_pow` in which `decide` can check the hypothesis on
the images). -/
theorem card_closure_range_eq_two_pow_of_monoidHom {H : Type*} [CommMonoid H] [Fintype ι]
    (hg : ∀ i, g i ^ 2 = 1) (Ψ : G →* H) (h : ∀ s : Finset ι, ∏ i ∈ s, Ψ (g i) = 1 → s = ∅) :
    Nat.card (closure (Set.range g)) = 2 ^ Fintype.card ι :=
  card_closure_range_eq_two_pow hg fun s hs ↦ h s (by simpa using congr(Ψ $hs))

end Subgroup

end
