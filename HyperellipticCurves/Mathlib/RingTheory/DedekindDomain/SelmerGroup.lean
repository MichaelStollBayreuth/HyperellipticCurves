open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum FractionalIdeal

open scoped nonZeroDivisors

namespace IsDedekindDomain.HeightOneSpectrum

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K]

theorem valuationOfNeZero_eq_iff (v : HeightOneSpectrum R) (u : Kˣ) (m : Multiplicative ℤ) :
    v.valuationOfNeZero u = m ↔ v.valuation K (u : K) = (m : WithZero (Multiplicative ℤ)) := by
  rw [← WithZero.coe_inj, valuationOfNeZero_eq]

@[simp]
theorem valuationOfNeZero_neg (v : HeightOneSpectrum R) (u : Kˣ) :
    v.valuationOfNeZero (-u) = v.valuationOfNeZero u := by
  rw [valuationOfNeZero_eq_iff, Units.val_neg, Valuation.map_neg, valuationOfNeZero_eq]

/-- If the valuation of a unit `u` is the `n`-th power of the valuation of a unit `z`, then the
`v`-adic order of `u` is divisible by `n`. -/
theorem dvd_toAdd_valuationOfNeZero (v : HeightOneSpectrum R) {n : ℕ} {u z : Kˣ}
    (h : v.valuation K (u : K) = v.valuation K (z : K) ^ n) :
    (n : ℤ) ∣ Multiplicative.toAdd (v.valuationOfNeZero u) := by
  have hu : v.valuationOfNeZero u = v.valuationOfNeZero z ^ n := by
    rw [valuationOfNeZero_eq_iff]
    push_cast
    rw [valuationOfNeZero_eq, h]
  exact ⟨Multiplicative.toAdd (v.valuationOfNeZero z), by rw [hu]; simp [toAdd_pow]⟩

/-- The image of the class of a unit `u` under the `v`-adic valuation mod `n` is the class in
`ZMod n` of the `v`-adic order of `u`. This holds by definition, but the `Multiplicative`/`Additive`
defeq abuse in `IsDedekindDomain.HeightOneSpectrum.valuationOfNeZeroMod` blocks unfolding it. -/
theorem valuationOfNeZeroMod_mk (v : HeightOneSpectrum R) (n : ℕ) (u : Kˣ) :
    v.valuationOfNeZeroMod n (u : Units.ModPow K n) =
      Multiplicative.ofAdd ((Multiplicative.toAdd (v.valuationOfNeZero u) : ℤ) : ZMod n) :=
  rfl

/-- The Selmer condition at `v` on the class of a unit `u`: the `v`-adic order of `u` is divisible
by `n`. -/
theorem valuationOfNeZeroMod_mk_eq_one_iff (v : HeightOneSpectrum R) (n : ℕ) (u : Kˣ) :
    v.valuationOfNeZeroMod n (u : Units.ModPow K n) = 1 ↔
      (n : ℤ) ∣ Multiplicative.toAdd (v.valuationOfNeZero u) := by
  rw [valuationOfNeZeroMod_mk, ofAdd_eq_one, ZMod.intCast_zmod_eq_zero_iff_dvd]

/-- The `v`-adic valuation of `x : K` is `exp (-count v (x))`: the multiplicity
`FractionalIdeal.count` of `v` in the principal fractional ideal `(x)` recovers the valuation. -/
theorem valuation_eq_exp_neg_count (v : HeightOneSpectrum R) {x : K} (hx : x ≠ 0) :
    v.valuation K x = WithZero.exp (-count K v (spanSingleton R⁰ x)) := by
  have key (r : R) (hr : r ≠ 0) : v.valuation K (algebraMap R K r) =
      WithZero.exp (-count K v (spanSingleton R⁰ (algebraMap R K r))) := by
    rw [valuation_of_algebraMap, intValuation_if_neg _ hr, ← coeIdeal_span_singleton,
      count_coe K v (by simpa using hr)]
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := R) x
  have hb0 : (b : R) ≠ 0 := nonZeroDivisors.ne_zero hb
  have ha0 : a ≠ 0 := by rintro rfl; simp at hx
  have hs (r : R) (hr : r ≠ 0) : spanSingleton R⁰ (algebraMap R K r) ≠ 0 := by
    rwa [spanSingleton_ne_zero_iff, ne_eq, _root_.map_eq_zero_iff _ (IsFractionRing.injective R K)]
  have hcount : count K v (spanSingleton R⁰ (algebraMap R K a / algebraMap R K b)) =
      count K v (spanSingleton R⁰ (algebraMap R K a)) -
        count K v (spanSingleton R⁰ (algebraMap R K b)) := by
    rw [← spanSingleton_div_spanSingleton, div_eq_mul_inv,
      count_mul K v (hs a ha0) (inv_ne_zero (hs b hb0)), count_inv, sub_eq_add_neg]
  rw [map_div₀, key a ha0, key b hb0, hcount, div_eq_mul_inv, ← WithZero.exp_neg,
    ← WithZero.exp_add]
  congr 1
  ring

/-- The `v`-adic order of a unit `x : Kˣ` is `-count v (x)`: the additive form of
`IsDedekindDomain.HeightOneSpectrum.valuation_eq_exp_neg_count`. -/
theorem toAdd_valuationOfNeZero (v : HeightOneSpectrum R) (x : Kˣ) :
    Multiplicative.toAdd (v.valuationOfNeZero x) = -count K v (spanSingleton R⁰ (x : K)) := by
  have h : (v.valuationOfNeZero x : WithZero (Multiplicative ℤ)) =
      WithZero.exp (-count K v (spanSingleton R⁰ (x : K))) := by
    rw [valuationOfNeZero_eq, valuation_eq_exp_neg_count v x.ne_zero]
  rw [WithZero.exp_eq_coe_ofAdd, WithZero.coe_inj] at h
  rw [h, toAdd_ofAdd]

/-- The `v`-adic order of a unit `x` of `K` that comes from `r : R` is minus the multiplicity of
`v` in the ideal `(r)`. -/
theorem toAdd_valuationOfNeZero_eq_neg_multiplicity (v : HeightOneSpectrum R) {x : Kˣ} {r : R}
    (h : algebraMap R K r = x) :
    Multiplicative.toAdd (v.valuationOfNeZero x) =
      -(multiplicity v.asIdeal (Ideal.span {r}) : ℤ) := by
  have hr : r ≠ 0 := fun hr ↦ x.ne_zero (by rw [← h, hr, map_zero])
  have hv : v.valuationOfNeZero x = .ofAdd (-(multiplicity v.asIdeal (Ideal.span {r}) : ℤ)) :=
    (v.valuationOfNeZero_eq_iff x _).mpr (by
      rw [← h, valuation_of_algebraMap, intValuation_eq_exp_neg_multiplicity v hr]
      rfl)
  rw [hv, toAdd_ofAdd]

end IsDedekindDomain.HeightOneSpectrum

namespace IsDedekindDomain.HeightOneSpectrum

variable {B C : Type*} [CommRing B] [IsDedekindDomain B] [CommRing C] [IsDedekindDomain C]
  {L N : Type*} [Field L] [Algebra B L] [IsFractionRing B L] [Field N] [Algebra C N]
  [IsFractionRing C N]

/-- Divisibility of adic orders transports along compatible embeddings `ψ : B →+* C` of Dedekind
domains and `φ : L →+* N` of their fraction fields: if the order of `u` at the contraction of `w`
is divisible by `n`, so is the `w`-adic order of `u' = φ u`, a multiple of it
(`IsDedekindDomain.HeightOneSpectrum.exists_valuation_map_eq_pow`). -/
theorem dvd_toAdd_valuationOfNeZero_map {φ : L →+* N} {ψ : B →+* C}
    (hcomp : (algebraMap C N).comp ψ = φ.comp (algebraMap B L)) {w : HeightOneSpectrum C}
    (hne : w.asIdeal.comap ψ ≠ ⊥) {n : ℕ} {u : Lˣ} {u' : Nˣ} (hu : (u' : N) = φ u)
    (h : (n : ℤ) ∣ Multiplicative.toAdd ((comapOfNeBot ψ w hne).valuationOfNeZero u)) :
    (n : ℤ) ∣ Multiplicative.toAdd (w.valuationOfNeZero u') := by
  obtain ⟨e, he⟩ := exists_valuation_map_eq_pow hcomp hne
  have hu' : w.valuationOfNeZero u' = (comapOfNeBot ψ w hne).valuationOfNeZero u ^ e := by
    rw [valuationOfNeZero_eq_iff, WithZero.coe_pow, valuationOfNeZero_eq, hu]
    exact he u
  rw [hu', toAdd_pow, nsmul_eq_mul]
  exact h.mul_left _

end IsDedekindDomain.HeightOneSpectrum

namespace IsDedekindDomain

section Above

variable (R : Type*) [CommRing R] (B : Type*) [CommRing B] [IsDedekindDomain B] [Algebra R B]
  (L : Type*) [Field L] [Algebra B L] [IsFractionRing B L]

/-- The Selmer group of `L`, where `B` is a Dedekind domain with fraction field `L` and `S` is a
set of primes of `R`: the classes of `Lˣ` modulo `n`-th powers whose valuation is divisible by `n`
at every prime of `B` not lying above `S`. -/
def selmerGroupAbove (S : Set (HeightOneSpectrum R)) (n : ℕ) : Subgroup (Units.ModPow L n) :=
  selmerGroup (R := B) (K := L) (S := HeightOneSpectrum.primesAbove R B S) (n := n)

theorem mem_selmerGroupAbove_iff (S : Set (HeightOneSpectrum R)) (n : ℕ)
    (x : Units.ModPow L n) :
    x ∈ selmerGroupAbove R B L S n ↔
      ∀ w ∉ HeightOneSpectrum.primesAbove R B S, w.valuationOfNeZeroMod n x = 1 :=
  Iff.rfl

end Above

section Neg

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K]

@[simp]
theorem mk_neg_mem_selmerGroup_iff {S : Set (HeightOneSpectrum R)} {n : ℕ} (u : Kˣ) :
    ((-u : Kˣ) : Units.ModPow K n) ∈ selmerGroup (K := K) (S := S) (n := n) ↔
      (u : Units.ModPow K n) ∈ selmerGroup (K := K) (S := S) (n := n) :=
  forall₂_congr fun v _ ↦ by
    rw [HeightOneSpectrum.valuationOfNeZeroMod_mk, HeightOneSpectrum.valuationOfNeZeroMod_mk,
      HeightOneSpectrum.valuationOfNeZero_neg]

end Neg

variable {R : Type*} [CommRing R] [IsDedekindDomain R] (K : Type*) [Field K] [Algebra R K]
  [IsFractionRing R K] (S : Set (HeightOneSpectrum R))

/-!
### `S`-units

Sending an `S`-unit to its tuple of valuations at the primes in `S` is a homomorphism to `ℤ ^ S`
whose kernel is the group of `∅`-units, the units of `R`. For finite `S` this makes the `S`-units
an extension of a subgroup of a free abelian group of finite rank by `Rˣ`.
-/

/-- The tuple of `v`-adic valuations of an `S`-unit at the primes `v ∈ S`. -/
noncomputable def sUnitValuation : S.unit K →* (S → Multiplicative ℤ) where
  toFun x v := (v : HeightOneSpectrum R).valuationOfNeZero (x : Kˣ)
  map_one' := funext fun _ ↦ map_one _
  map_mul' _ _ := funext fun _ ↦ map_mul ..

@[simp]
theorem sUnitValuation_apply (x : S.unit K) (v : S) :
    sUnitValuation K S x v = (v : HeightOneSpectrum R).valuationOfNeZero (x : Kˣ) :=
  rfl

/-- The kernel of `IsDedekindDomain.sUnitValuation` consists of the `∅`-units. -/
theorem ker_sUnitValuation :
    (sUnitValuation K S).ker =
      ((∅ : Set (HeightOneSpectrum R)).unit K).subgroupOf (S.unit K) := by
  ext x
  simp only [MonoidHom.mem_ker, funext_iff, Pi.one_apply, sUnitValuation_apply,
    Subgroup.mem_subgroupOf]
  refine ⟨fun hx v _ ↦ ?_, fun hx v ↦ ?_⟩
  · by_cases hv : v ∈ S
    · simpa using (v.valuationOfNeZero_eq_iff (x : Kˣ) 1).mp (hx ⟨v, hv⟩)
    · exact x.property v hv
  · exact (v.1.valuationOfNeZero_eq_iff (x : Kˣ) 1).mpr (by
      simpa using hx v.1 (Set.notMem_empty _))

variable (R) in
/-- The `∅`-units of `K` are the units of `R`. -/
noncomputable def unitsEquivEmptyUnit : Rˣ ≃* (∅ : Set (HeightOneSpectrum R)).unit K :=
  let e₁ : R ≃ₐ[R] (⊥ : Subalgebra R K) :=
    (Algebra.botEquivOfInjective (IsFractionRing.injective R K)).symm
  let e₂ : (⊥ : Subalgebra R K) ≃ₐ[R] (∅ : Set (HeightOneSpectrum R)).integer K :=
    Subalgebra.equivOfEq _ _ (IsDedekindDomain.integer_empty R K).symm
  (Units.mapEquiv (e₁.trans e₂).toRingEquiv.toMulEquiv).trans (Set.unitEquivUnitsInteger _ K).symm

/-- **Dirichlet's `S`-unit theorem**, weak form: if `Rˣ` is finitely generated and `S` is finite,
then the group of `S`-units is finitely generated, as an extension of a subgroup of `ℤ ^ S` by
`Rˣ` (`IsDedekindDomain.ker_sUnitValuation`, `IsDedekindDomain.unitsEquivEmptyUnit`). -/
theorem isMulFG_sUnit [IsMulFG Rˣ] (hS : S.Finite) : IsMulFG (S.unit K) := by
  have : Finite S := hS.to_subtype
  refine .of_ker_of_range (sUnitValuation K S) ?_ (Subgroup.isMulFG_of_commGroup _)
  rw [ker_sUnitValuation]
  have : IsMulFG ((∅ : Set (HeightOneSpectrum R)).unit K) :=
    .of_surjective (unitsEquivEmptyUnit R K) (unitsEquivEmptyUnit R K).surjective
  have hle : (∅ : Set (HeightOneSpectrum R)).unit K ≤ S.unit K := Set.unit_mono S.empty_subset
  exact .of_surjective _ (Subgroup.subgroupOfEquivOfLe hle).symm.surjective

/-!
### The fundamental exact sequence
-/

variable (n : ℕ)

/-- The class of an `S`-unit lies in the Selmer group `K⟮S, n⟯`. -/
def sUnitToSelmer : S.unit K →* selmerGroup (K := K) (S := S) (n := n) where
  toFun x := ⟨(x : Kˣ), fun v hv ↦ by
    rw [HeightOneSpectrum.valuationOfNeZeroMod_mk_eq_one_iff]
    have : v.valuationOfNeZero (x : Kˣ) = 1 :=
      (v.valuationOfNeZero_eq_iff (x : Kˣ) 1).mpr (by rw [x.property v hv, WithZero.coe_one])
    simp [this]⟩
  map_one' := rfl
  map_mul' _ _ := rfl

@[simp]
theorem coe_sUnitToSelmer (x : S.unit K) :
    (sUnitToSelmer K S n x : Units.ModPow K n) = ((x : Kˣ) : Units.ModPow K n) :=
  rfl

/-- The left-hand map of the fundamental exact sequence: the `S`-units modulo `n`-th powers of
`S`-units map to the Selmer group `K⟮S, n⟯`. -/
noncomputable def sUnitModPowToSelmer :
    (S.unit K ⧸ (powMonoidHom n : S.unit K →* S.unit K).range) →*
      selmerGroup (K := K) (S := S) (n := n) :=
  QuotientGroup.lift _ (sUnitToSelmer K S n) <| by
    rintro _ ⟨x, rfl⟩
    exact Subtype.ext ((QuotientGroup.eq_one_iff _).mpr ⟨(x : Kˣ), rfl⟩)

@[simp]
theorem range_sUnitModPowToSelmer :
    (sUnitModPowToSelmer K S n).range = (sUnitToSelmer K S n).range := by
  ext
  exact ⟨by rintro ⟨y, rfl⟩; induction y using QuotientGroup.induction_on with
    | H y => exact ⟨y, rfl⟩, fun ⟨y, hy⟩ ↦ ⟨y, hy⟩⟩

/-- The valuations of `K` at the primes of the `S`-integers are those at the primes of `R` off
`S`. -/
theorem SInteger.valuationOfNeZero_heightOneSpectrumEquiv
    (v : {v : HeightOneSpectrum R // v ∉ S}) (u : Kˣ) :
    (SInteger.heightOneSpectrumEquiv K S v).valuationOfNeZero u =
      (v : HeightOneSpectrum R).valuationOfNeZero u := by
  rw [← WithZero.coe_inj, HeightOneSpectrum.valuationOfNeZero_eq,
    HeightOneSpectrum.valuationOfNeZero_eq, SInteger.valuation_heightOneSpectrumEquiv K S v (u : K)]

/-- The class of `u` lies in the Selmer group `K⟮S, n⟯` exactly when the principal fractional ideal
`(u)` of the `S`-integers is `n`-divisible. -/
theorem mem_selmerGroup_iff_unitsNDivisible (u : Kˣ) :
    (u : Units.ModPow K n) ∈ selmerGroup (R := R) (K := K) (S := S) (n := n) ↔
      u ∈ unitsNDivisible (S.integer K) K n := by
  rw [mem_unitsNDivisible, ← (SInteger.heightOneSpectrumEquiv K S).forall_congr_right,
    Subtype.forall]
  exact forall₂_congr fun v hv ↦ by
    rw [HeightOneSpectrum.valuationOfNeZeroMod_mk_eq_one_iff,
      ← SInteger.valuationOfNeZero_heightOneSpectrumEquiv K S ⟨v, hv⟩,
      HeightOneSpectrum.toAdd_valuationOfNeZero, Int.dvd_neg]

/-- The surjection from the `n`-divisible units onto the Selmer group. -/
noncomputable def selmerGroupFromUnits :
    unitsNDivisible (S.integer K) K n →* selmerGroup (R := R) (K := K) (S := S) (n := n) :=
  (QuotientGroup.mk' (powMonoidHom n : Kˣ →* Kˣ).range).restrict
    fun u hu ↦ (mem_selmerGroup_iff_unitsNDivisible K S n u).mpr hu

@[simp]
theorem coe_selmerGroupFromUnits (u : unitsNDivisible (S.integer K) K n) :
    (selmerGroupFromUnits K S n u : Units.ModPow K n) = ((u : Kˣ) : Units.ModPow K n) :=
  rfl

theorem selmerGroupFromUnits_surjective :
    Function.Surjective (selmerGroupFromUnits K S n) := by
  intro ⟨c, hc⟩
  induction c using QuotientGroup.induction_on with
  | H u => exact ⟨⟨u, (mem_selmerGroup_iff_unitsNDivisible K S n u).mp hc⟩, rfl⟩

/-- The kernel of `IsDedekindDomain.selmerGroupFromUnits` lies in that of the `n`-th-root class
map: an `n`-th power has principal `n`-th root. -/
theorem ker_selmerGroupFromUnits_le [NeZero n] :
    (selmerGroupFromUnits K S n).ker ≤ (nthRootClass (S.integer K) K n).ker := by
  intro u hu
  rw [MonoidHom.mem_ker] at hu ⊢
  obtain ⟨w, hw⟩ := (QuotientGroup.eq_one_iff _).mp congr(Subtype.val $hu)
  exact (nthRootClass_eq_one_iff _ _ (NeZero.ne n) u).mpr ⟨1, w, by rwa [map_one, one_mul]⟩

/-- The right-hand map of the fundamental exact sequence: a Selmer class goes to the ideal class
of the `n`-th root of the principal ideal `(u)` of a representative `u`, in the class group of the
`S`-integers; `FractionalIdeal.nthRootClass` descended along
`IsDedekindDomain.selmerGroupFromUnits`. -/
noncomputable def toSClassGroup [NeZero n] :
    selmerGroup (R := R) (K := K) (S := S) (n := n) →* ClassGroup (S.integer K) :=
  (QuotientGroup.lift _ (nthRootClass (S.integer K) K n)
      (ker_selmerGroupFromUnits_le K S n)).comp
    (QuotientGroup.quotientKerEquivOfSurjective _
      (selmerGroupFromUnits_surjective K S n)).symm.toMonoidHom

theorem toSClassGroup_selmerGroupFromUnits [NeZero n] (u : unitsNDivisible (S.integer K) K n) :
    toSClassGroup K S n (selmerGroupFromUnits K S n u) = nthRootClass (S.integer K) K n u := by
  have h : (QuotientGroup.quotientKerEquivOfSurjective _
      (selmerGroupFromUnits_surjective K S n)).symm (selmerGroupFromUnits K S n u) =
        QuotientGroup.mk u := by
    rw [MulEquiv.symm_apply_eq]
    rfl
  rw [toSClassGroup, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, h, QuotientGroup.lift_mk']

/-- Exactness of the fundamental exact sequence in the middle: a Selmer class has trivial
`n`-th-root ideal class exactly when it is the class of an `S`-unit. -/
theorem ker_toSClassGroup [NeZero n] :
    (toSClassGroup K S n).ker = (sUnitToSelmer K S n).range := by
  ext x
  obtain ⟨u, rfl⟩ := selmerGroupFromUnits_surjective K S n x
  rw [MonoidHom.mem_ker, toSClassGroup_selmerGroupFromUnits,
    nthRootClass_eq_one_iff _ _ (NeZero.ne n)]
  simp only [MonoidHom.mem_range, Subtype.ext_iff, coe_sUnitToSelmer, coe_selmerGroupFromUnits]
  refine (S.unitEquivUnitsInteger K).symm.toEquiv.exists_congr fun a ↦ ?_
  rw [eq_comm, Units.ModPow.mk_eq_mk_iff]
  refine exists_congr fun w ↦ ?_
  simp only [MulEquiv.toEquiv_eq_coe, MulEquiv.coe_toEquiv, Set.coe_unitEquivUnitsInteger_symm,
    eq_comm]

variable (R) in
/-- **The Selmer group `K⟮S, n⟯` is finite** if the class group of `R` is finite, `Rˣ` is
finitely generated, `S` is finite and `n ≠ 0`: the kernel of `IsDedekindDomain.toSClassGroup` is
the image of the finite group of `S`-units modulo `n`-th powers (`IsDedekindDomain.isMulFG_sUnit`,
`IsDedekindDomain.ker_toSClassGroup`), and its target `ClassGroup (S.integer K)` is finite
(`IsDedekindDomain.SInteger.finite_classGroup`). -/
theorem finite_selmerGroup [Finite (ClassGroup R)] [IsMulFG Rˣ] (hS : S.Finite) [NeZero n] :
    Finite (selmerGroup (K := K) (S := S) (n := n)) := by
  have := isMulFG_sUnit K S hS
  have hker : Finite (toSClassGroup K S n).ker := by
    rw [ker_toSClassGroup, ← range_sUnitModPowToSelmer]
    have := Subgroup.finiteIndex_range_powMonoidHom_of_fg (S.unit K) (NeZero.ne n)
    exact Finite.Set.finite_range _
  have : Finite (selmerGroup (K := K) (S := S) (n := n) ⧸ (toSClassGroup K S n).ker) :=
    .of_injective _ (QuotientGroup.kerLift_injective (toSClassGroup K S n))
  exact Finite.of_subgroup_quotient (toSClassGroup K S n).ker

variable {S} in
/-- The Selmer group of `L = Frac B` relative to the primes above a finite set `S` of primes of
`R` is finite, if `Cl(B)` is finite and `Bˣ` is finitely generated. -/
theorem finite_selmerGroupAbove (B : Type*) [CommRing B] [IsDedekindDomain B] [Algebra R B]
    [Algebra.IsIntegral R B] [Module.IsTorsionFree R B] [Finite (ClassGroup B)] [IsMulFG Bˣ]
    (L : Type*) [Field L] [Algebra B L] [IsFractionRing B L] (hS : S.Finite) [NeZero n] :
    Finite (selmerGroupAbove R B L S n) :=
  finite_selmerGroup B L _ n (HeightOneSpectrum.primesAbove_finite R B hS)

/-!
### Selmer groups of finite products of fields

For a family of Dedekind domains `B i` with fraction fields `L i` and sets `S i` of primes of
`B i`, the Selmer group of the product is the product of the Selmer groups; for an algebra `A`
with a decomposition `Units.ModPow A n ≃* ((i : ι) → Units.ModPow (L i) n)` (for instance
`AdjoinRoot.modPowEquivPiFactors`), it is transported along the decomposition.
-/

section Pi

variable {ι : Type*} (L : ι → Type*) [(i : ι) → Field (L i)]
  (B : (i : ι) → Type*) [(i : ι) → CommRing (B i)] [(i : ι) → IsDedekindDomain (B i)]
  [(i : ι) → Algebra (B i) (L i)] [(i : ι) → IsFractionRing (B i) (L i)]
  (S : (i : ι) → Set (HeightOneSpectrum (B i))) (n : ℕ)

/-- The product of the Selmer groups of the fields `L i`. -/
def selmerGroupPi : Subgroup ((i : ι) → Units.ModPow (L i) n) :=
  Subgroup.pi Set.univ fun i ↦ selmerGroup (R := B i) (K := L i) (S := S i) (n := n)

theorem mem_selmerGroupPi_iff (x : (i : ι) → Units.ModPow (L i) n) :
    x ∈ selmerGroupPi L B S n ↔
      ∀ i, x i ∈ selmerGroup (R := B i) (K := L i) (S := S i) (n := n) := by
  simp [selmerGroupPi, Subgroup.mem_pi]

/-- A finite product of finite Selmer groups is finite. -/
theorem finite_selmerGroupPi [Finite ι] [(i : ι) → Finite (ClassGroup (B i))]
    [(i : ι) → IsMulFG (B i)ˣ] (hS : ∀ i, (S i).Finite) [NeZero n] :
    Finite (selmerGroupPi L B S n) := by
  have (i : ι) : Finite (selmerGroup (R := B i) (K := L i) (S := S i) (n := n)) :=
    finite_selmerGroup (B i) (L i) (S i) n (hS i)
  exact .of_injective (fun x i ↦ (⟨x.1 i, (mem_selmerGroupPi_iff L B S n x.1).mp x.2 i⟩ :
    selmerGroup (R := B i) (K := L i) (S := S i) (n := n)))
    fun x y hxy ↦ Subtype.ext <| funext fun i ↦ congr(Subtype.val ($hxy i))

variable {A : Type*} [CommRing A]

/-- The Selmer group of `A`, transported along a decomposition of `Units.ModPow A n` into the
product of the `Units.ModPow (L i) n`. -/
def selmerGroupOfEquiv (e : Units.ModPow A n ≃* ((i : ι) → Units.ModPow (L i) n)) :
    Subgroup (Units.ModPow A n) :=
  (selmerGroupPi L B S n).comap e.toMonoidHom

theorem mem_selmerGroupOfEquiv_iff (e : Units.ModPow A n ≃* ((i : ι) → Units.ModPow (L i) n))
    (x : Units.ModPow A n) :
    x ∈ selmerGroupOfEquiv L B S n e ↔
      ∀ i, e x i ∈ selmerGroup (R := B i) (K := L i) (S := S i) (n := n) :=
  mem_selmerGroupPi_iff L B S n (e x)

/-- The Selmer group of an algebra decomposed into finitely many fields with finite Selmer groups
is finite. -/
theorem finite_selmerGroupOfEquiv [Finite ι] [(i : ι) → Finite (ClassGroup (B i))]
    [(i : ι) → IsMulFG (B i)ˣ] (hS : ∀ i, (S i).Finite) [NeZero n]
    (e : Units.ModPow A n ≃* ((i : ι) → Units.ModPow (L i) n)) :
    Finite (selmerGroupOfEquiv L B S n e) := by
  have := finite_selmerGroupPi L B S n hS
  exact .of_injective (fun x ↦ (⟨e x.1, x.2⟩ : selmerGroupPi L B S n))
    fun x y hxy ↦ Subtype.ext <| e.injective congr(Subtype.val $hxy)

end Pi

end IsDedekindDomain

namespace IsDedekindDomain

open HeightOneSpectrum

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K] {B : Type*} [CommRing B] [IsDedekindDomain B] [Algebra R B]
  [Algebra.IsIntegral R B] {F : Type*} [Field F] [Algebra B F] [IsFractionRing B F] [Algebra K F]
  [Algebra R F] [IsScalarTower R K F] [IsScalarTower R B F] [FiniteDimensional K F]
  [Algebra.IsSeparable K F]

-- The case of an integral element in `IsDedekindDomain.toAdd_valuationOfNeZero_norm`.
private theorem toAdd_valuationOfNeZero_norm_of_algebraMap_eq (v : HeightOneSpectrum R) {x : Fˣ}
    {b : B} (h : algebraMap B F b = x) :
    Multiplicative.toAdd (v.valuationOfNeZero (Units.map (Algebra.norm K : F →* K) x)) =
      ∑ᶠ w ∈ primesAbove R B {v},
        (w.asIdeal.inertiaDeg R : ℤ) * Multiplicative.toAdd (w.valuationOfNeZero x) := by
  have : Module.IsTorsionFree R B :=
    Module.isTorsionFree_iff_faithfulSMul.mpr (.of_field_isFractionRing R B K F)
  have := IsIntegralClosure.finite R K F B
  have := FractionRing.isSeparable_of_isFractionRing R K B F
  have hb : b ≠ 0 := fun hb ↦ x.ne_zero (by rw [← h, hb, map_zero])
  rw [toAdd_valuationOfNeZero_eq_neg_multiplicity v (r := Algebra.intNorm R B b)
    (by rw [Units.coe_map, ← h, Algebra.algebraMap_intNorm (L := F)]), ← Ideal.relNorm_singleton,
    Ideal.multiplicity_relNorm v (Ideal.span_singleton_eq_bot.not.mpr hb),
    Nat.cast_finsum_mem (primesAbove_singleton_finite v),
    ← finsum_mem_neg_distrib _ (primesAbove_singleton_finite v)]
  refine finsum_mem_congr rfl fun w _ ↦ ?_
  rw [toAdd_valuationOfNeZero_eq_neg_multiplicity w h]
  push_cast
  ring

variable (B) in
/-- **The valuation of a norm**: for a prime `v` of `R` and `x ∈ Fˣ`,
`v(N_{F/K} x) = ∑_{w ∣ v} f(w ∣ v) w(x)`, the sum over the primes `w` of `B` above `v`, weighted by
their inertia degrees. -/
theorem toAdd_valuationOfNeZero_norm (v : HeightOneSpectrum R) (x : Fˣ) :
    Multiplicative.toAdd (v.valuationOfNeZero (Units.map (Algebra.norm K : F →* K) x)) =
      ∑ᶠ w ∈ primesAbove R B {v},
        (w.asIdeal.inertiaDeg R : ℤ) * Multiplicative.toAdd (w.valuationOfNeZero x) := by
  have : Module.IsTorsionFree R B :=
    Module.isTorsionFree_iff_faithfulSMul.mpr (.of_field_isFractionRing R B K F)
  obtain ⟨b, c, hc, hx⟩ := IsFractionRing.div_surjective (A := B) (x : F)
  have hc0 : algebraMap B F c ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hc
  have hb0 : algebraMap B F b ≠ 0 := fun hb ↦ x.ne_zero (by rw [← hx, hb, zero_div])
  obtain rfl : x = Units.mk0 _ hb0 / Units.mk0 _ hc0 := Units.ext (by simp [hx])
  rw [_root_.map_div, _root_.map_div, toAdd_div,
    toAdd_valuationOfNeZero_norm_of_algebraMap_eq v (Units.val_mk0 hb0).symm,
    toAdd_valuationOfNeZero_norm_of_algebraMap_eq v (Units.val_mk0 hc0).symm,
    ← finsum_mem_sub_distrib _ _ (primesAbove_singleton_finite v)]
  refine finsum_mem_congr rfl fun w _ ↦ ?_
  rw [_root_.map_div, toAdd_div, mul_sub]

variable (K) in
/-- **Norms map Selmer groups to Selmer groups**: the norm of `F/K` maps the Selmer group of `F`
relative to the primes of `B` above `S` into the Selmer group `K⟮S, n⟯`, as the valuation of a norm
at `v` is a combination of the valuations at the primes above `v`
(`IsDedekindDomain.toAdd_valuationOfNeZero_norm`). -/
theorem norm_mem_selmerGroup {S : Set (HeightOneSpectrum R)} {n : ℕ} {x : Units.ModPow F n}
    (hx : x ∈ selmerGroupAbove R B F S n) :
    Units.ModPow.map (Algebra.norm K : F →* K) n x ∈
      selmerGroup (R := R) (K := K) (S := S) (n := n) := by
  induction x using QuotientGroup.induction_on with | H u => ?_
  intro v hv
  rw [Units.ModPow.map_mk, valuationOfNeZeroMod_mk_eq_one_iff, toAdd_valuationOfNeZero_norm B]
  refine finsum_mem_induction _ (dvd_zero _) (fun _ _ ↦ dvd_add) fun w hw ↦
    dvd_mul_of_dvd_right ?_ _
  refine (valuationOfNeZeroMod_mk_eq_one_iff w n u).mp
    ((mem_selmerGroupAbove_iff R B F S n _).mp hx w ?_)
  rwa [mem_primesAbove_iff, mem_primesAbove_singleton_iff.mp hw]

end IsDedekindDomain

/-- The norm of the image in `F` of a class of `K` is its `[F : K]`-th power. -/
theorem Units.ModPow.map_norm_map_algebraMap {K F : Type*} [Field K] [Field F]
    [Algebra K F] {n : ℕ} (x : Units.ModPow K n) :
    Units.ModPow.map (Algebra.norm K : F →* K) n (Units.ModPow.map (algebraMap K F : K →* F) n x) =
      x ^ Module.finrank K F := by
  induction x using QuotientGroup.induction_on with | H u => ?_
  rw [Units.ModPow.map_mk, Units.ModPow.map_mk, ← QuotientGroup.mk_pow]
  congr 1
  ext
  simp [Algebra.norm_algebraMap]

namespace IsDedekindDomain

open HeightOneSpectrum

section Restriction

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K] {B : Type*} [CommRing B] [IsDedekindDomain B] [Algebra R B]
  [Algebra.IsIntegral R B] {L : Type*} [Field L] [Algebra B L] [IsFractionRing B L]
  [Algebra K L] [Algebra R L] [IsScalarTower R K L] [IsScalarTower R B L]

/-- **Restriction of Selmer groups**: `Kˣ/(Kˣ)ⁿ → Lˣ/(Lˣ)ⁿ` maps `K⟮S, n⟯` into the Selmer group
of `L` relative to the primes above `S`, as the valuation of `L` at `w` restricts to a power of
that of `K` at the prime below `w`
(`IsDedekindDomain.HeightOneSpectrum.dvd_toAdd_valuationOfNeZero_map`). -/
theorem map_algebraMap_mem_selmerGroupAbove {S : Set (HeightOneSpectrum R)} {n : ℕ}
    {x : Units.ModPow K n} (hx : x ∈ selmerGroup (R := R) (K := K) (S := S) (n := n)) :
    Units.ModPow.map (algebraMap K L : K →* L) n x ∈ selmerGroupAbove R B L S n := by
  induction x using QuotientGroup.induction_on with | H u => ?_
  refine (mem_selmerGroupAbove_iff R B L S n _).mpr fun w hw ↦ ?_
  rw [Units.ModPow.map_mk, valuationOfNeZeroMod_mk_eq_one_iff]
  refine dvd_toAdd_valuationOfNeZero_map (φ := algebraMap K L) (ψ := algebraMap R B) ?_
    (w.under R).ne_bot rfl ?_
  · rw [← IsScalarTower.algebraMap_eq, ← IsScalarTower.algebraMap_eq]
  · exact (valuationOfNeZeroMod_mk_eq_one_iff _ n u).mp
      (hx _ ((mem_primesAbove_iff ..).not.mp hw))

end Restriction

section Norm

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K] {B : Type*} [CommRing B] [IsDedekindDomain B] [Algebra R B]
  [Algebra.IsIntegral R B] {F : Type*} [Field F] [Algebra B F] [IsFractionRing B F] [Algebra K F]
  [Algebra R F] [IsScalarTower R K F] [IsScalarTower R B F] [FiniteDimensional K F]
  [Algebra.IsSeparable K F]

/-- For a finite separable extension `F / K` of degree prime to `n`, a class of `K` lies in
`K⟮S, n⟯` exactly when its image in `F` lies in the Selmer group of `F` relative to the primes
above `S`: the norm of the image is the `[F : K]`-th power of the class
(`IsDedekindDomain.norm_mem_selmerGroup`), and the classes have exponent `n`. -/
theorem map_algebraMap_mem_selmerGroupAbove_iff {S : Set (HeightOneSpectrum R)} {n : ℕ}
    (hd : (Module.finrank K F).Coprime n) {x : Units.ModPow K n} :
    Units.ModPow.map (algebraMap K F : K →* F) n x ∈ selmerGroupAbove R B F S n ↔
      x ∈ selmerGroup (R := R) (K := K) (S := S) (n := n) := by
  refine ⟨fun h ↦ ?_, map_algebraMap_mem_selmerGroupAbove⟩
  obtain ⟨m, hm⟩ := exists_pow_eq_self_of_coprime
    (hd.coprime_dvd_right (orderOf_dvd_of_pow_eq_one (Units.ModPow.pow_eq_one x)))
  exact hm ▸ pow_mem (Units.ModPow.map_norm_map_algebraMap (F := F) x ▸ norm_mem_selmerGroup K h) m

end Norm

section Generator

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K] {v : HeightOneSpectrum R} {r : R} {u : Kˣ}

/-- The `v`-adic order of a generator of `v` is `1`. -/
theorem HeightOneSpectrum.toAdd_valuationOfNeZero_eq_neg_one_of_span_eq
    (hr : Ideal.span {r} = v.asIdeal) (hu : (u : K) = algebraMap R K r) :
    Multiplicative.toAdd (v.valuationOfNeZero u) = -1 := by
  have hr0 : r ≠ 0 := fun h ↦ v.ne_bot (by rw [← hr, h, Ideal.span_singleton_eq_bot])
  rw [(v.valuationOfNeZero_eq_iff u (.ofAdd (-1))).mpr, toAdd_ofAdd]
  rw [hu, valuation_of_algebraMap, v.intValuation_singleton hr0 hr.symm, WithZero.exp_eq_coe_ofAdd]

/-- A generator of `v` is a unit at every other prime `w`. -/
theorem HeightOneSpectrum.valuationOfNeZero_eq_one_of_span_eq (hr : Ideal.span {r} = v.asIdeal)
    (hu : (u : K) = algebraMap R K r) {w : HeightOneSpectrum R} (hw : w ≠ v) :
    w.valuationOfNeZero u = 1 := by
  rw [w.valuationOfNeZero_eq_iff, hu, WithZero.coe_one, valuation_eq_one_iff_notMem]
  refine fun h ↦ hw (HeightOneSpectrum.ext (v.isMaximal.eq_of_le w.isPrime.ne_top ?_).symm)
  rwa [← hr, Ideal.span_singleton_le_iff_mem]

/-- Adding a principal prime `v = (r)` to `S` adds the class of the generator `r` to the Selmer
group: a class in `K⟮S ∪ {v}, n⟯` times a power of the class of `r` with valuation `0` at `v`
lies in `K⟮S, n⟯`. -/
theorem selmerGroup_insert (hr : Ideal.span {r} = v.asIdeal) (hu : (u : K) = algebraMap R K r)
    (S : Set (HeightOneSpectrum R)) (n : ℕ) :
    selmerGroup (R := R) (K := K) (S := insert v S) (n := n) =
      selmerGroup (R := R) (K := K) (S := S) (n := n) ⊔
        Subgroup.zpowers (u : Units.ModPow K n) := by
  refine le_antisymm (fun x hx ↦ ?_) (sup_le (selmerGroup.monotone (Set.subset_insert v S))
    (Subgroup.zpowers_le.mpr fun w hw ↦ ?_))
  · induction x using QuotientGroup.induction_on with | H y => ?_
    set k := Multiplicative.toAdd (v.valuationOfNeZero y)
    have hk : ((y * u ^ k : Kˣ) : Units.ModPow K n) ∈ selmerGroup (R := R) (K := K) (S := S)
        (n := n) := fun w hw ↦ by
      rw [valuationOfNeZeroMod_mk_eq_one_iff, map_mul, map_zpow, toAdd_mul, toAdd_zpow]
      rcases eq_or_ne w v with rfl | hwv
      · simp [k, HeightOneSpectrum.toAdd_valuationOfNeZero_eq_neg_one_of_span_eq hr hu]
      · rw [HeightOneSpectrum.valuationOfNeZero_eq_one_of_span_eq hr hu hwv, toAdd_one,
          smul_zero, add_zero]
        exact (valuationOfNeZeroMod_mk_eq_one_iff _ n y).mp (hx w (by simp [hwv, hw]))
    have hy : (y : Units.ModPow K n) = ((y * u ^ k : Kˣ) : Units.ModPow K n) * (u : _) ^ (-k) := by
      rw [← QuotientGroup.mk_zpow, ← QuotientGroup.mk_mul, mul_assoc, ← zpow_add, add_neg_cancel,
        zpow_zero, mul_one]
    exact hy ▸ Subgroup.mul_mem_sup hk (Subgroup.zpow_mem_zpowers _ (-k))
  · rw [valuationOfNeZeroMod_mk_eq_one_iff,
      HeightOneSpectrum.valuationOfNeZero_eq_one_of_span_eq hr hu (by grind), toAdd_one]
    exact dvd_zero _

end Generator

section ClassGroup

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K]

open FractionalIdeal in
/-- If the class group of `R` is trivial, every class in `K⟮∅, n⟯` comes from a unit of `R`, for
`n ≠ 0`: the `n`-th root of the principal ideal of a representative is principal
(`FractionalIdeal.nthRootClass_eq_one_iff`). -/
theorem selmerGroup.fromUnit_surjective [Subsingleton (ClassGroup R)] {n : ℕ} [NeZero n] :
    Function.Surjective (selmerGroup.fromUnit (R := R) (K := K) (n := n)) := by
  intro ⟨x, hx⟩
  induction x using QuotientGroup.induction_on with | H u => ?_
  have hu : u ∈ unitsNDivisible R K n := mem_unitsNDivisible.mpr fun v ↦ by
    simpa [valuationOfNeZeroMod_mk_eq_one_iff, toAdd_valuationOfNeZero] using
      hx v (Set.notMem_empty v)
  obtain ⟨a, w, h⟩ := (nthRootClass_eq_one_iff R K (NeZero.ne n) ⟨u, hu⟩).mp (Subsingleton.elim _ _)
  exact ⟨a, Subtype.ext (Units.ModPow.mk_eq_mk_iff.mpr
    ⟨w⁻¹, by rw [inv_pow]; exact eq_mul_inv_of_mul_eq h⟩)⟩

/-- If the class group of `R` is trivial, `K⟮∅, n⟯` is the image of the units of `R`, for `n ≠ 0`
(`IsDedekindDomain.selmerGroup.fromUnit_surjective`). -/
theorem selmerGroup_empty [Subsingleton (ClassGroup R)] {n : ℕ} [NeZero n] :
    selmerGroup (R := R) (K := K) (S := ∅) (n := n) =
      (Units.ModPow.map (algebraMap R K : R →* K) n).range := by
  refine le_antisymm (fun x hx ↦ ?_) ?_
  · obtain ⟨a, ha⟩ := selmerGroup.fromUnit_surjective (R := R) (K := K) ⟨x, hx⟩
    exact ⟨a, (Units.ModPow.map_mk ..).trans congr(Subtype.val $ha)⟩
  · rintro _ ⟨y, rfl⟩
    induction y using QuotientGroup.induction_on with | H a => ?_
    exact (selmerGroup.fromUnit a).2

/-- **Generators of the Selmer group** of a Dedekind domain `R` with trivial class group: for
`n ≠ 0` and finitely many primes `v i` with generators `r i`, `K⟮{v i}, n⟯` is generated by the
image of the units of `R` and the classes of the `r i`. By induction
(`IsDedekindDomain.selmerGroup_insert`) from `IsDedekindDomain.selmerGroup_empty`. -/
theorem selmerGroup_image_eq_range_sup_closure [Subsingleton (ClassGroup R)] {n : ℕ} [NeZero n]
    {ι : Type*} {s : Set ι} (hs : s.Finite) {v : ι → HeightOneSpectrum R} {r : ι → R}
    {u : ι → Kˣ} (hr : ∀ i ∈ s, Ideal.span {r i} = (v i).asIdeal)
    (hu : ∀ i ∈ s, (u i : K) = algebraMap R K (r i)) :
    selmerGroup (R := R) (K := K) (S := v '' s) (n := n) =
      (Units.ModPow.map (algebraMap R K : R →* K) n).range ⊔
        Subgroup.closure ((fun i ↦ (u i : Units.ModPow K n)) '' s) := by
  induction s, hs using Set.Finite.induction_on with
  | empty => simp [selmerGroup_empty]
  | @insert i s _ _ ih =>
    rw [Set.forall_mem_insert] at hr hu
    rw [Set.image_insert_eq, selmerGroup_insert hr.1 hu.1, ih hr.2 hu.2, Set.image_insert_eq,
      Set.insert_eq, Subgroup.closure_union, ← Subgroup.zpowers_eq_closure, sup_assoc,
      sup_comm (Subgroup.zpowers _)]

/-- **Generators of the Selmer group** of a Dedekind domain `R` with trivial class group: for
`n ≠ 0` and a finite family of primes `v i` with generators `r i`, `K⟮{v i}, n⟯` is generated by
the image of the units of `R` and the classes of the `r i`. -/
theorem selmerGroup_range_eq_range_sup_closure [Subsingleton (ClassGroup R)] {n : ℕ} [NeZero n]
    {ι : Type*} [Finite ι] {v : ι → HeightOneSpectrum R} {r : ι → R} {u : ι → Kˣ}
    (hr : ∀ i, Ideal.span {r i} = (v i).asIdeal) (hu : ∀ i, (u i : K) = algebraMap R K (r i)) :
    selmerGroup (R := R) (K := K) (S := Set.range v) (n := n) =
      (Units.ModPow.map (algebraMap R K : R →* K) n).range ⊔
        Subgroup.closure (Set.range fun i ↦ (u i : Units.ModPow K n)) := by
  simpa only [Set.image_univ] using
    selmerGroup_image_eq_range_sup_closure Set.finite_univ (fun i _ ↦ hr i) fun i _ ↦ hu i

end ClassGroup

end IsDedekindDomain
